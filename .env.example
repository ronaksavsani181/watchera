# ============================================================
# WATCHERA FULL STACK ENVIRONMENT TEMPLATE (.env.example)
# ============================================================

# --- SERVER / RENDER ENVIRONMENT VARIABLES ---
NODE_ENV=production
PORT=10000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/watchera?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_jwt_secret_token_at_least_32_characters
CLIENT_URL=https://your-watchera-frontend.vercel.app,http://localhost:4200
RAZORPAY_KEY_ID=rzp_test_yourRazorpayKeyId
RAZORPAY_KEY_SECRET=yourRazorpayKeySecret

# --- CLIENT / VERCEL SETTINGS ---
# Set in client/vercel.json rewrite destination:
# https://your-watchera-backend.onrender.com/api/:path*
