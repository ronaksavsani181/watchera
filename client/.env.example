# ============================================================
# WATCHERA FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================

# When deployed on Vercel, by default requests use relative '/api' which
# is rewritten via vercel.json to your Render backend (recommended to avoid CORS).
# Alternatively, if you want direct API calls, specify your Render backend URL:
# e.g. https://watchera-backend.onrender.com/api
WATCHERA_API_URL=https://your-watchera-backend.onrender.com/api
