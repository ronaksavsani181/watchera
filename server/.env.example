# ============================================================
# WATCHERA BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Duplicate this file as '.env' and fill in your actual credentials.
# NEVER commit your real '.env' file with production secrets!
# ============================================================

# Environment mode ('development' or 'production')
NODE_ENV=production

# Server Port (Render automatically supplies PORT in production, default 5000/10000)
PORT=5000

# MongoDB Atlas connection string
# Replace <username>, <password>, and <cluster> with your database details
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/watchera?retryWrites=true&w=majority

# Secret key for signing JSON Web Tokens (use a strong random 32+ character string)
JWT_SECRET=replace_with_a_long_random_jwt_secret_token_at_least_32_characters

# Allowed Frontend URLs for CORS (comma-separated if multiple, e.g. your Vercel URL and localhost)
CLIENT_URL=https://your-watchera-frontend.vercel.app,http://localhost:4200

# Razorpay Payment Gateway Credentials (Get these from your Razorpay Dashboard)
RAZORPAY_KEY_ID=rzp_test_yourRazorpayKeyId
RAZORPAY_KEY_SECRET=yourRazorpayKeySecret
