# ============================================================
# WATCHERA BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================

# Environment mode ('development' or 'production')
NODE_ENV=production

# Server Port (Render automatically supplies PORT in production, default 5000/10000)
PORT=5000

# MongoDB Atlas connection string (supported as MONGO_URI or DATABASE_URL)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/watchera-web?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/watchera-web?retryWrites=true&w=majority

# Secret key for signing JSON Web Tokens
JWT_SECRET=replace_with_a_long_random_jwt_secret_token_at_least_32_characters

# Allowed Frontend URLs for CORS (comma-separated: Vercel frontend and localhost)
CLIENT_URL=https://watchera-store.vercel.app,http://localhost:4200,http://localhost:3000

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_yourRazorpayKeyId
RAZORPAY_KEY_SECRET=yourRazorpayKeySecret
